# Base de datos PostgreSQL (con plan gratuito de Render usa una externa, p. ej. Neon)
DATABASE_URL=postgres://usuario:clave@host/versova?sslmode=require
# true para conexiones con SSL (Neon, Render Postgres). false solo para Postgres local.
DB_SSL=true

# Clave para entrar a la consola web (mínimo 12 caracteres)
CONSOLE_KEY=cambia-esta-clave-larga

# Números del propietario del bot, con código de país, separados por coma. Ej: 59899999999
OWNER_NUMBERS=

# Opcional: número del bot para emparejar por código automáticamente al arrancar
BOT_PHONE=

PORT=3000
