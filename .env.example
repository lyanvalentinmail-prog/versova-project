# PostgreSQL administrado en Neon (recomendado, plan gratuito).
# Usa la cadena de conexión pooled de Neon; normalmente el host contiene "-pooler".
DATABASE_URL=postgresql://usuario:clave@ep-ejemplo-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon requiere TLS. Para Postgres local puedes poner false.
DB_SSL=true

# Números del propietario del bot, con código de país, separados por coma. Ej: 59899999999
OWNER_NUMBERS=59896719709

# Email del propietario: a él llegan los tickets (reportes) de la web.
OWNER_EMAIL=lyanvalentinmail@gmail.com

# Opcional: número del bot para emparejar por código automáticamente al arrancar
BOT_PHONE=

PORT=3000

# Opcional: inicio de sesión con Google (OAuth). Sin estas variables, el acceso
# es con email y contraseña (demo). Redirect URI: <origen>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: SMTP para avisar al owner por email cuando llega un ticket.
# Sin MAIL_HOST/MAIL_USER/MAIL_PASS el aviso va solo por WhatsApp.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Versova <no-reply@versova.app>

# Pon 0 para desactivar el acceso con email y dejar solo Google.
DEMO_LOGIN=1

# Paquete que responde al arrancar: versova | raiden | yae-miku.
# Luego manda el bot que elijas en el panel (/store, /bots o /registrar?bot=<slug>).
BOT_TYPE=versova

# Pon 0 para que los bots del catálogo no hagan peticiones externas (descargas, metadatos, IA).
BOT_ALLOW_NETWORK=1

# Opcional: API de descargas estilo Cobalt para .download y .play de Raiden WaBot.
DOWNLOAD_API_URL=

# Opcional: proveedor compatible con OpenAI para .ai de Raiden WaBot.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=400
